{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iStickies",
  "version": "0.1.0",
  "identifier": "com.dmytrofiliurskyi.stickies",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "iStickies",
        "url": "index.html",
        "width": 380,
        "height": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
